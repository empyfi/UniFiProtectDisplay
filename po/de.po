msgid "Contacting the console..."
msgstr "Kontaktiere die Konsole ..."

#: src/usr/lib/enigma2/python/Plugins/Extensions/UnifiProtectDisplay/ui/setup.py:225
msgid "Connected. Protect version %s"
msgstr "Verbunden. Protect-Version %s"

